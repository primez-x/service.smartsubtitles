<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="service.smartsubtitles">
        <category id="general" label="32001" help=""> <!-- General -->
            <group id="1" label="">
                <setting id="enabled" type="boolean" label="32002" help=""> <!-- Enable Smart Subtitles -->
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="respect_language" type="boolean" label="32005" help=""> <!-- Only select tracks in my preferred subtitle language (from Kodi settings) -->
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="notify_selected" type="boolean" label="32006" help=""> <!-- Show notification when a track is selected -->
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="notify_no_match" type="boolean" label="32008" help="32009">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="remember_manual" type="boolean" label="32010" help="32011">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="keywords" type="string" label="32003" help="32007"> <!-- Track name keywords (comma-separated) -->
                    <level>0</level>
                    <default>signs,songs,forced</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32003</heading>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
